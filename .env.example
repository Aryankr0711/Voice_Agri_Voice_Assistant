# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your API credentials.
# Note: The .env file is git-ignored and must never be committed.
# =============================================================================

# ─── PRIMARY PROVIDER: Groq (Speech-to-Text & Fast Open-Weight LLMs) ─────────
# Get a free key at: https://console.groq.com
# Whisper-large-v3 provides voice transcription in Hindi, Marathi, Punjabi, English.
# Open-weight LLMs handle intent understanding and chosen-language replies.
GROQ_API_KEY=
GROQ_LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# ─── FALLBACK PROVIDER: Google Gemini (Chat & Reasoning Failover) ─────────────
# Get a free key at: https://aistudio.google.com/app/apikey
# Automatically called when Groq encounters rate-limiting (429) or service outages.
GEMINI_API_KEY=
GEMINI_LLM_MODELS=gemini-1.5-flash,gemini-1.5-pro

# ─── Agent Engine ─────────────────────────────────────────────────────────────
# Options: langchain (LangChain ReAct AgentExecutor) | sequential (deterministic)
AGENT_BACKEND=langchain

# ─── Runtime Mode ─────────────────────────────────────────────────────────────
# true  → Lite Mode: memory optimized (~170 MB RAM, BM25 search, no PyTorch)
# false → Full Mode: local embeddings, FAISS vectorstore, offline models
LITE_MODE=true

# ─── Speech & Audio ───────────────────────────────────────────────────────────
WHISPER_MODEL_ID=openai/whisper-large-v3
TTS_ENGINE=gtts

# ─── RAG & Vectorstore ────────────────────────────────────────────────────────
VECTORSTORE_PATH=data/vectorstore
RAG_BACKEND=bm25
RAG_MIN_SCORE=0.35
TOP_K=5

# ─── Weather Services (Free, No Key Required) ─────────────────────────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# ─── Application Settings ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEV_MODE=false
